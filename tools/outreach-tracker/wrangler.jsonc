{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobmax-outreach-tracker",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "jobmax-outreach-tracker", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
